# ============================
# Application
# ============================

NODE_ENV=development
PORT=4001
APP_NAME=remitIQ-market-service



# ============================
# Database
# ============================

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/market_db



# ============================
# Logging
# ============================

LOG_LEVEL=info



# ============================
# External FX Provider
# ============================

FX_API_URL=https://api.example.com
FX_API_KEY=



# ============================
# Security
# ============================

JWT_SECRET=



# ============================
# CORS
# ============================

CORS_ORIGIN=http://localhost:3000